# Copy to .env and adjust as needed. Loaded by both `docker compose` and
# Next.js (which reads .env in addition to .env.local).

# Postgres (shared by the app and GoTrue). POSTGRES_USER must be "postgres"
# — GoTrue's own migrations grant privileges to a role of that name.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hyllan
POSTGRES_DB=hyllan
POSTGRES_PORT=5432

# Used by the app (via Drizzle) and by drizzle-kit
DATABASE_URL=postgres://postgres:hyllan@localhost:5432/hyllan

# Self-hosted Supabase Auth (GoTrue). Connects as its own dedicated
# Postgres role (supabase_auth_admin, created by docker/postgres-init) so
# it can own the auth schema without affecting the app's own role.
GOTRUE_PORT=9999
# Dev-only placeholders — for production these must be the real public
# app/auth URLs (see DOMAIN/AUTH_DOMAIN below), not localhost.
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_API_EXTERNAL_URL=http://localhost:9999
GOTRUE_DB_PASSWORD=supabase_auth_admin
# Dev-only placeholder — generate a real secret (e.g. `openssl rand -base64 32`) for any shared/deployed environment.
GOTRUE_JWT_SECRET=local-dev-only-secret-do-not-use-in-production

# Signs the Send Email Hook requests GoTrue makes to
# src/app/api/auth/send-email-hook/route.ts (compose.yaml's `auth` service)
# — local dev's stand-in for SMTP, since none is configured there (see
# PER-263). Must be `v1,whsec_<base64>`; the placeholder below is dev-only,
# any value in that shape works locally. Not used in staging/production,
# which have real SMTP configured instead and leave this hook disabled.
GOTRUE_HOOK_SEND_EMAIL_SECRETS=v1,whsec_bG9jYWwtZGV2LW9ubHktc2VjcmV0LWRvLW5vdC11c2U=

# @supabase/ssr client config. NEXT_PUBLIC_SUPABASE_URL is the app's own
# origin, not GoTrue's directly — next.config.ts rewrites /auth/v1/* to
# GOTRUE_API_EXTERNAL_URL, standing in for the path-prefixing Kong would do
# in the full Supabase stack. NEXT_PUBLIC_SUPABASE_ANON_KEY is never checked
# by standalone GoTrue (that's Kong's job too) — any non-empty value works.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-unused-by-standalone-gotrue

# Optional. GoTrue's address on the internal Docker network `app` and `auth`
# share (see compose.yaml) — set this in staging/production so server-side
# auth checks (src/proxy.ts, src/lib/auth.ts) reach GoTrue directly instead
# of round-tripping out through the public domain and back in through
# next.config.ts's rewrite (PER-272). Leave unset for local dev, where
# NEXT_PUBLIC_SUPABASE_URL above already points at the same machine.
# GOTRUE_API_INTERNAL_URL=http://auth:9999

# Production only (docker compose --profile production ...) — see README's
# "Production deployment" section. Not used by local dev.

# Public domains Caddy requests/renews HTTPS certificates for (DNS must
# already point at this host). AUTH_DOMAIN must match GOTRUE_API_EXTERNAL_URL
# above, e.g. https://auth.example.com.
DOMAIN=app.example.com
AUTH_DOMAIN=auth.example.com

# Off-server shipping target for the daily pg_dump/pg_dumpall backups, as an
# rclone remote:path (see `rclone config` docs for supported backends —
# S3-compatible object storage, B2, etc). Leave unset to keep dumps local
# only (not recommended for production, since a VPS-level disaster would
# take the backups down with it — but supported for hosts that don't need
# it). The remote's own credentials are supplied via RCLONE_CONFIG_<REMOTE>_*
# variables added to this file, e.g. for a remote named "backup":
#   RCLONE_CONFIG_BACKUP_TYPE=s3
#   RCLONE_CONFIG_BACKUP_PROVIDER=Other
#   RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=...
#   RCLONE_CONFIG_BACKUP_ENDPOINT=...
BACKUP_RCLONE_REMOTE=backup:hyllan-backups
BACKUP_RETENTION_DAYS=7

# Error tracking: self-hosted GlitchTip (Sentry-API-compatible). Deploying
# GlitchTip itself is the operator's concern — see README's "Observability"
# section. Leave both unset (as here) to run with error reporting disabled;
# both must point at the same GlitchTip project when set.
GLITCHTIP_DSN=
# Must be NEXT_PUBLIC_-prefixed since it's read in the browser bundle.
NEXT_PUBLIC_GLITCHTIP_DSN=
