# Copy to .env and adjust as needed. Loaded by both `docker compose` and
# Next.js (which reads .env in addition to .env.local).

# Postgres (shared by the app and GoTrue). POSTGRES_USER must be "postgres"
# — GoTrue's own migrations grant privileges to a role of that name.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hyllan
POSTGRES_DB=hyllan
POSTGRES_PORT=5432

# Used by the app (via Drizzle) and by drizzle-kit
DATABASE_URL=postgres://postgres:hyllan@localhost:5432/hyllan

# Self-hosted Supabase Auth (GoTrue). Connects as its own dedicated
# Postgres role (supabase_auth_admin, created by docker/postgres-init) so
# it can own the auth schema without affecting the app's own role.
GOTRUE_PORT=9999
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_API_EXTERNAL_URL=http://localhost:9999
GOTRUE_DB_PASSWORD=supabase_auth_admin
# Dev-only placeholder — generate a real secret (e.g. `openssl rand -base64 32`) for any shared/deployed environment.
GOTRUE_JWT_SECRET=local-dev-only-secret-do-not-use-in-production

# @supabase/ssr client config. NEXT_PUBLIC_SUPABASE_URL is the app's own
# origin, not GoTrue's directly — next.config.ts rewrites /auth/v1/* to
# GOTRUE_API_EXTERNAL_URL, standing in for the path-prefixing Kong would do
# in the full Supabase stack. NEXT_PUBLIC_SUPABASE_ANON_KEY is never checked
# by standalone GoTrue (that's Kong's job too) — any non-empty value works.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-unused-by-standalone-gotrue
